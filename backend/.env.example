# ==============================================================================
# Quill Backend Environment Variables (.env)
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# Server Port (Render automatically sets this in production)
PORT=5000

# Database Connection:
# Local Development:
MONGO_URI=mongodb://localhost:27017/QuilDB
# Production (MongoDB Atlas — include database name before query string):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/QuilDB?retryWrites=true&w=majority

# JWT signing secret (use at least 32 random characters in production)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Frontend base URL (used for CORS and verification / password-reset email links)
# Local Development:
FRONTEND_URL=http://localhost:5173
# Production (set to your deployed Vercel frontend URL without trailing slash):
# FRONTEND_URL=https://your-quill-app.vercel.app

# Additional allowed CORS origins (optional, comma-separated)
# ALLOWED_ORIGINS=https://your-quill-app.vercel.app,https://yourdomain.com

# Google OAuth Client ID (must match frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Resend — transactional email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email sender address
# Development: use Resend's test address (no custom domain needed)
EMAIL_FROM=onboarding@resend.dev
# Production: use your verified domain
# EMAIL_FROM=Quill <noreply@yourdomain.com>

# Rate limiting (optional overrides — defaults shown)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=15
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=100