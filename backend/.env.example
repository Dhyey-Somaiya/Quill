MONGO_URI=mongodb://localhost:27017/QuilDB
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Resend — transactional email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# During development use Resend's built-in test address (no domain verification needed):
EMAIL_FROM=onboarding@resend.dev
# In production, replace with your verified domain:
# EMAIL_FROM=Quill <noreply@yourdomain.com>

# Frontend base URL (used to build email links)
FRONTEND_URL=http://localhost:5173

# Rate limiting (optional — defaults shown)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=15
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=100